<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <svg
    class="h-full w-full"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="gem-hatch" width="10" height="10" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="10" stroke="#B25E3D" stroke-width="2.5" opacity="0.55"></line>
      </pattern>
      <radialGradient id="wash" cx="30%" cy="10%" r="80%">
        <stop offset="0%" stop-color="#F1E9D8"></stop>
        <stop offset="100%" stop-color="#FAF8F3"></stop>
      </radialGradient>
    </defs>

    <rect width="1440" height="900" fill="url(#wash)"></rect>

    <!-- faceted gem-sun motif, top right -->
    <circle cx="1240" cy="150" r="120" fill="url(#gem-hatch)"></circle>
    <circle cx="1240" cy="150" r="120" fill="none" stroke="#2B2620" stroke-width="1.5" opacity="0.25"></circle>

    <!-- soft organic blobs, clustered clear of the text column and CTAs (right two-fifths only) -->
    <path
      d="M1150,560 C1070,520 1080,420 1180,400 C1280,380 1360,440 1350,530 C1340,620 1280,700 1190,690 C1110,682 1220,600 1150,560 Z"
      fill="#5B6740"
      opacity="0.10"
    ></path>
    <path
      d="M1300,760 C1240,730 1250,660 1320,650 C1390,642 1410,710 1370,750 C1330,790 1360,820 1300,760 Z"
      fill="#CBBFA4"
      opacity="0.30"
    ></path>

    <!-- squiggle doodles, kept to the margins -->
    <path
      d="M1300,300 C1340,280 1360,320 1400,300"
      stroke="#B25E3D"
      stroke-width="3"
      stroke-linecap="round"
      fill="none"
      opacity="0.3"
    ></path>
    <path
      d="M950,120 C980,100 1000,135 1035,118"
      stroke="#2B2620"
      stroke-width="2.5"
      stroke-linecap="round"
      fill="none"
      opacity="0.2"
    ></path>
    <path
      d="M60,60 C95,42 110,80 148,62"
      stroke="#5B6740"
      stroke-width="2.5"
      stroke-linecap="round"
      fill="none"
      opacity="0.25"
    ></path>
  </svg>
</div>
