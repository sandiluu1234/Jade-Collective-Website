  <div class="mx-auto flex max-w-content flex-col items-start justify-between gap-6 px-6 py-10 sm:px-8 md:flex-row md:items-center">
    <span class="inline-flex items-center gap-2 font-logo text-lg uppercase leading-none tracking-tight text-espresso">
      Jade
      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-terracotta" aria-hidden="true"></span>
      Collective
    </span>
    <div class="font-body text-sm text-espresso/70">
      <p>partnerships@jadecollectiveagency.com</p>
      <p class="mt-1">&copy; {year} Jade Collective. All rights reserved.</p>
    </div>
  </div>
</footer>
