<div
  class="pointer-events-none fixed bottom-7 right-7 z-40 hidden h-24 w-16 items-center justify-center rounded-2xl border border-stone/50 bg-cream/80 shadow-sm backdrop-blur sm:flex"
  aria-hidden="true"
  data-hourglass
>
  <svg viewBox="0 0 100 160" class="h-[86%] w-[86%]">
    <defs>
      <clipPath id="hourglass-top-clip">
        <polygon points="22,14 78,14 50,78" />
      </clipPath>
      <clipPath id="hourglass-bottom-clip">
        <polygon points="50,82 78,146 22,146" />
      </clipPath>
    </defs>

    <!-- neck stream -->
    <rect x="49.3" y="76" width="1.4" height="8" class="fill-terracotta" opacity="0.5" />

    <!-- sand -->
    <rect
      data-sand-top
      x="22"
      y="14"
      width="56"
      height="64"
      clip-path="url(#hourglass-top-clip)"
      class="fill-terracotta"
      opacity="0.7"
    />
    <rect
      data-sand-bottom
      x="22"
      y="146"
      width="56"
      height="0"
      clip-path="url(#hourglass-bottom-clip)"
      class="fill-terracotta"
      opacity="0.7"
    />

    <!-- glass outline -->
    <rect x="18" y="6" width="64" height="6" rx="2" class="fill-none stroke-espresso" stroke-width="2.5" opacity="0.45" />
    <rect x="18" y="148" width="64" height="6" rx="2" class="fill-none stroke-espresso" stroke-width="2.5" opacity="0.45" />
    <path
      d="M22,14 L78,14 L50,78 L50,82 L78,146 L22,146 L50,82 L50,78 Z"
      class="fill-none stroke-espresso"
      stroke-width="2.5"
      stroke-linejoin="round"
      opacity="0.45"
    />
  </svg>
</div>

<script>
  const topSandMax = 64;
  const bottomSandMax = 64;

  const topSand = document.querySelector<SVGRectElement>("[data-sand-top]");
  const bottomSand = document.querySelector<SVGRectElement>("[data-sand-bottom]");

  let ticking = false;

  function scrollProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (max <= 0) return 0;
    return Math.min(1, Math.max(0, window.scrollY / max));
  }

  function render() {
    if (!topSand || !bottomSand) return;
    const progress = scrollProgress();
    const topHeight = topSandMax * (1 - progress);
    const bottomHeight = bottomSandMax * progress;

    topSand.setAttribute("y", String(78 - topHeight));
    topSand.setAttribute("height", String(topHeight));

    bottomSand.setAttribute("y", String(146 - bottomHeight));
    bottomSand.setAttribute("height", String(bottomHeight));
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(render);
    }
  }

  render();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
