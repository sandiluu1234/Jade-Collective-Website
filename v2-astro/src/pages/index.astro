---
import Layout from "../layouts/Layout.astro";
import HeroBackground from "../components/HeroBackground.astro";
import AudioPlayerWidget from "../components/AudioPlayerWidget.astro";

const services = [
  {
    title: "Representation",
    body: "We become your team — fielding inbound, pitching you to the right brands, and making sure your name is in the rooms that matter.",
  },
  {
    title: "Brand Partnerships",
    body: "From sourcing to signed contract, we find deals that fit your voice and negotiate rates that respect your worth.",
  },
  {
    title: "Strategy & Direction",
    body: "Positioning, content direction, and growth planning — a clear point of view for where your brand goes next.",
  },
];
---

<Layout title="Jade Collective | Talent Management for Micro Creators">
  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pb-28 pt-16 sm:px-8 sm:pt-20 lg:pl-20">
    <HeroBackground />

    <span
      class="pointer-events-none absolute left-4 top-1/2 hidden w-40 -translate-x-1/2 -translate-y-1/2 -rotate-90 text-center font-body text-xs uppercase tracking-[0.32em] text-espresso/45 lg:block"
    >
      Representation &middot; Strategy &middot; Deals
    </span>

    <div class="mx-auto max-w-content">
      <div class="max-w-2xl">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-stone/70 bg-cream/70 px-4 py-1.5 font-body text-xs uppercase tracking-[0.16em] text-espresso/70 backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-terracotta"></span>
          Hello, we&rsquo;re Jade Collective. A &mdash;
        </p>
        <h1 class="text-5xl font-semibold leading-[1.05] text-espresso sm:text-6xl lg:text-[5rem] lg:leading-[1.03]">
          For the creators
          <br />
          the world hasn&rsquo;t
          <br />
          caught onto yet.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-espresso/80">
          Jade Collective is a boutique talent management studio for micro
          creators. I&rsquo;m here to handle the brand deals, the negotiations,
          and the strategy — so you can stay focused on the work only you can
          make.
        </p>

        <div class="mt-10 max-w-sm">
          <AudioPlayerWidget src="/audio/meet-jade-collective.wav" caption="Meet Jade Collective" />
        </div>

        <div class="mt-14 flex flex-wrap items-center gap-8">
          <a
            href="/contact"
            class="cursor-pointer rounded-sm bg-olive px-7 py-3.5 font-body text-sm font-medium text-cream transition-colors duration-200 hover:bg-olive-dark"
          >
            Work with us
          </a>
          <a
            href="/services"
            class="cursor-pointer font-body text-sm font-medium text-espresso underline decoration-stone underline-offset-4 transition-colors duration-200 hover:text-olive hover:decoration-olive"
          >
            See how it works
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning -->
  <section class="bg-cream-alt">
    <div class="mx-auto max-w-content px-6 py-20 sm:px-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold leading-tight text-espresso sm:text-4xl">
          You don&rsquo;t need a million followers to build a real business.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-espresso/80">
          Micro creators are where brands are actually paying attention —
          engaged audiences, real trust, genuine influence. But most talent
          agencies only look up. We look closer. Jade Collective gives small
          and growing creators the kind of thoughtful, hands-on management
          usually reserved for the top of the industry.
        </p>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="bg-cream">
    <div class="mx-auto max-w-content px-6 py-20 sm:px-8">
      <div class="grid gap-12 sm:grid-cols-3 sm:gap-8">
        {services.map((service) => (
          <div>
            <h3 class="font-display text-2xl font-semibold text-espresso">
              {service.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-espresso/75">
              {service.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section class="bg-espresso text-cream">
    <div class="mx-auto max-w-content px-6 py-20 sm:px-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold leading-tight sm:text-4xl">
          Hi, I&rsquo;m Sandi — a talent manager who believes small creators
          deserve big representation.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-cream/80">
          I started Jade Collective because I kept seeing talented micro
          creators undercharge, get overlooked, and burn out doing the
          business side alone. I&rsquo;m here to carry that weight — and to
          build careers with intention, taste, and the long game in mind.
        </p>
        <a
          href="/about"
          class="mt-7 inline-block cursor-pointer font-body text-sm font-medium text-cream underline decoration-stone/60 underline-offset-4 transition-colors duration-200 hover:text-sage-light hover:decoration-sage-light"
        >
          More about Sandi
        </a>
      </div>
    </div>
  </section>

  <!-- Social proof placeholder -->
  <section class="bg-sage/15">
    <div class="mx-auto max-w-content px-6 py-20 sm:px-8">
      <blockquote class="max-w-2xl border-l-2 border-terracotta pl-6 font-display text-xl italic leading-relaxed text-espresso/85 sm:text-2xl">
        &ldquo;Add 1–3 short creator testimonials here once you have them —
        even a single line about a deal you landed or how it felt to finally
        have support goes a long way.&rdquo;
      </blockquote>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-olive text-cream">
    <div class="mx-auto max-w-content px-6 py-24 sm:px-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold leading-tight sm:text-4xl">
          Ready for a manager in your corner?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-cream/85">
          We take on a small number of creators at a time, so every
          partnership gets real attention.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-block cursor-pointer rounded-sm bg-cream px-7 py-3.5 font-body text-sm font-medium text-espresso transition-colors duration-200 hover:bg-cream-alt"
        >
          Apply to work with us
        </a>
      </div>
    </div>
  </section>
</Layout>
