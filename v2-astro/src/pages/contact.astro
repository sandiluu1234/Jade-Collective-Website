---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Jade Collective">
  <section class="mx-auto max-w-content px-6 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-16 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="max-w-lg">
        <h1 class="text-4xl font-semibold leading-tight text-ink sm:text-5xl">
          Let&rsquo;s talk.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-ink/80">
          Whether you&rsquo;re a creator looking for management or a brand
          hoping to work with one of ours, I&rsquo;d love to hear from you.
        </p>

        <div class="mt-10 space-y-8 border-t border-stone/60 pt-10">
          <div>
            <h2 class="font-display text-xl font-semibold text-ink">
              For creators
            </h2>
            <p class="mt-2 text-base leading-relaxed text-ink/75">
              Tell me a little about you, what you make, and where
              you&rsquo;re headed. I take on a small number of clients at a
              time, so I read every application personally.
            </p>
          </div>
          <div>
            <h2 class="font-display text-xl font-semibold text-ink">
              For brands
            </h2>
            <p class="mt-2 text-base leading-relaxed text-ink/75">
              Looking to partner with authentic micro creators? Let me know
              what you have in mind.
            </p>
          </div>
        </div>
      </div>

      <form id="contact-form" class="border border-stone/60 p-8 sm:p-10">
        <div id="form-fields" class="grid gap-6">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block font-body text-sm text-ink/80">
                Name <span class="text-clay">*</span>
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="w-full rounded-sm border border-stone bg-bone px-4 py-3 text-ink outline-none transition-colors duration-200 focus:border-jade"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block font-body text-sm text-ink/80">
                Email <span class="text-clay">*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full rounded-sm border border-stone bg-bone px-4 py-3 text-ink outline-none transition-colors duration-200 focus:border-jade"
              />
            </div>
          </div>

          <div>
            <label for="handle" class="mb-1.5 block font-body text-sm text-ink/80">
              Instagram / TikTok handle
            </label>
            <input
              id="handle"
              name="handle"
              type="text"
              placeholder="@yourhandle"
              class="w-full rounded-sm border border-stone bg-bone px-4 py-3 text-ink outline-none transition-colors duration-200 focus:border-jade"
            />
          </div>

          <div>
            <label for="role" class="mb-1.5 block font-body text-sm text-ink/80">
              I&rsquo;m a&hellip;
            </label>
            <select
              id="role"
              name="role"
              class="w-full rounded-sm border border-stone bg-bone px-4 py-3 text-ink outline-none transition-colors duration-200 focus:border-jade"
            >
              <option value="creator">Creator</option>
              <option value="brand">Brand</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-1.5 block font-body text-sm text-ink/80">
              Tell me a bit more <span class="text-clay">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={5}
              class="w-full rounded-sm border border-stone bg-bone px-4 py-3 text-ink outline-none transition-colors duration-200 focus:border-jade"
            ></textarea>
          </div>

          <button
            type="submit"
            class="cursor-pointer justify-self-start rounded-sm bg-ink px-8 py-3.5 font-body text-sm font-medium text-bone transition-colors duration-200 hover:bg-jade"
          >
            Send message
          </button>
        </div>

        <div id="form-success" class="hidden py-10 text-center" role="status">
          <p class="font-display text-2xl font-semibold text-ink">Thank you.</p>
          <p class="mt-2 text-sm text-ink/70">
            We&rsquo;ve received your message and will be in touch soon.
          </p>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const fields = document.getElementById("form-fields");
  const success = document.getElementById("form-success");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    fields?.classList.add("hidden");
    success?.classList.remove("hidden");
  });
</script>
